# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated or single)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Replace <password> with your MongoDB database user password and <cluster-name> with your cluster address
# Example: mongodb+srv://kssudheesh818_db_user:mySecretPassword123@cluster0.xyz123.mongodb.net/infrastructure?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://kssudheesh818_db_user:<password>@<cluster-address>.mongodb.net/infrastructure?retryWrites=true&w=majority
